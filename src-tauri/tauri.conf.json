{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sermon Studio",
  "version": "1.0.0",
  "identifier": "org.sermonstudio.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:4028",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sermon Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Offline expository sermon writing studio",
    "longDescription": "Sermon Studio is an offline, Linux-native expository sermon writing studio, compiler, and retrieval engine. Plain-text CommonMark sermons, a static KJV/Strong's canon vault, and a rebuildable SQLite retrieval index.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
